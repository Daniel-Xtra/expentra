# App
PORT=3000
NODE_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expentra
POSTGRES_LOGGING=false
POSTGRES_SSL=true
POSTGRES_SSL_REJECT_UNAUTHORIZED=true
# Docker staging/prod: POSTGRES_SSL=true and mount ca.crt at this path
POSTGRES_SSL_CA=/certs/postgres/ca.crt

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_DISABLE_SSL=true
# E2E tests override REDIS_URL via test/setup-e2e-env.ts (default: redis://127.0.0.1:6379)
# E2E_REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me
# Optional separate secret for refresh tokens (falls back to JWT_SECRET)
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES=7d
# Public self-service registration (default false — use admin provisioning in production)
ALLOW_PUBLIC_REGISTRATION=false
ALLOWED_ORIGINS=http://localhost:3000
# Set true only for local dev to use predictable OTP 123456 in emails
ALLOW_DEV_OPAQUE_TOKEN=false
# Set true when running behind a reverse proxy (nginx, load balancer)
TRUST_PROXY=false
# Global per-IP rate limit (all routes)
RATE_LIMIT_GLOBAL_LIMIT=300
RATE_LIMIT_GLOBAL_TTL=60
# Auth context cache TTL in seconds (0 disables cache)
AUTH_CONTEXT_CACHE_TTL_SECONDS=60
# OpenAPI docs at /api/docs when true
SWAGGER_ENABLED=false
# TLS certificate verification (set REJECT_UNAUTHORIZED=false only for self-signed without CA)
# POSTGRES_SSL_CA documented under PostgreSQL section above
REDIS_TLS_REJECT_UNAUTHORIZED=true
# REDIS_TLS_CA=/path/to/ca.pem
# BullMQ dashboard at /admin/queues when enabled.
# Local defaults are admin/admin if username/password are blank; set explicit values for shared environments.
QUEUE_DASHBOARD_ENABLED=false
QUEUE_DASHBOARD_USERNAME=
QUEUE_DASHBOARD_PASSWORD=

# Frontend (email links)
APP_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RECEIPT_FOLDER=expentra/receipts

# Approvals
APPROVAL_ESCALATION_DELAY_HOURS=72

# Budgets
BUDGET_TIMEZONE=Africa/Lagos
BUDGET_BLOCK_SUBMIT_ON_OVERSPEND=false
BUDGET_ALERT_THRESHOLD_PERCENT=80

# Logging
LOG_HTTP_REQUESTS=true

# Optional external notification API
NOTIFICATION_SERVICE_URL=
NOTIFICATION_CLIENT_ID=

# Observability (docker compose --profile observability)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Postgres backups (postgres-backup service)
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Docker entrypoint
# API containers: leave RUN_MIGRATIONS=true (default). Worker containers must set RUN_MIGRATIONS=false.
RUN_MIGRATIONS=true
RUN_SEED=false

# Runtime processes (same image / codebase)
# API:    node dist/main.js   (or pnpm run start / start:dev)
# Worker: node dist/worker.js (or pnpm run start:worker / start:worker:dev)
# Local and Docker Compose must run both api and worker or BullMQ jobs will not be consumed.
#
# Docker Compose image (VPS): CI sets IMAGE_NAME on deploy into env/.env.*
# IMAGE_NAME=youruser/expentra:latest

# Seed (super admin only)
SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_FIRST_NAME=Super
SEED_SUPER_ADMIN_LAST_NAME=Admin

# OIDC SSO (Azure AD / Okta / Google Workspace, etc.)
# Redirect URI must point at the API callback and be registered in the IdP app.
SSO_ENABLED=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
SSO_SCOPES=openid profile email
# When false, only existing Expentra users (matched by email) can sign in via SSO
SSO_AUTO_PROVISION=false
# Optional comma-separated allowlist, e.g. company.com,subsidiary.com
SSO_ALLOWED_EMAIL_DOMAINS=
SSO_BUTTON_LABEL=Sign in with SSO
