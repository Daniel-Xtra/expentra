{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "testTimeout": 60000,
  "setupFiles": ["<rootDir>/setup-e2e-env.ts"],
  "transformIgnorePatterns": [
    "/node_modules/(?!(uuid)/)"
  ],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "diagnostics": {
          "ignoreCodes": [151002]
        },
        "tsconfig": {
          "types": ["jest", "node"]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}